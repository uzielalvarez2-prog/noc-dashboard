# URL del dashboard (local o Vercel). El listener hace POST aquí.
DASHBOARD_URL=http://localhost:3000

# Clave interna compartida con el API del dashboard (misma que usa el scraper).
# Se manda en el header x-internal-key. NUNCA versionar el valor real.
INTERNAL_API_KEY=

# Nombre EXACTO del grupo de WhatsApp a escuchar (respetar acentos y mayúsculas).
WA_GROUP_NAME=STAFF SUPERVISIÓN

# Cuántos mensajes leer al arrancar para recuperar lo perdido si la PC estuvo apagada.
WA_BACKFILL_LIMIT=50

# Puerto del servidor HTTP de envío (dashboard → WhatsApp). En Railway lo inyecta
# PORT automáticamente; en local cae a 8080 si no se define.
# PORT=8080

# (Opcional) Ruta al Chrome del sistema para no descargar Chromium. Si se deja
# vacío, se autodetectan las rutas estándar de Windows; si tampoco hay, puppeteer
# usa su Chromium propio (requiere haberlo descargado).
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
