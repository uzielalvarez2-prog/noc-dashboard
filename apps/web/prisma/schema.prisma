generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Incident {
  id          String         @id
  title       String
  severity    Severity
  status      IncidentStatus
  assignedTo  String?
  slaDeadline DateTime
  slaBreached Boolean        @default(false)
  slaRiskAt   DateTime?
  source      String         @default("HPSM")
  rawData     Json
  createdAt   DateTime
  updatedAt   DateTime
  syncedAt    DateTime       @default(now())

  @@index([severity, status])
  @@index([slaDeadline])
  @@index([syncedAt])
}

model Operator {
  id        String  @id
  name      String
  email     String
  team      String
  isOnShift Boolean @default(false)
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  lastName     String     @default("")
  username     String     @default("")
  expediente   String     @default("")
  role         UserRole   @default(IDS)
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

model AlertRule {
  id         String       @id @default(cuid())
  name       String
  trigger    AlertTrigger
  channels   String[]
  recipients String[]
  isActive   Boolean      @default(true)
  createdBy  String
  createdAt  DateTime     @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOC v2 — modelo basado en los exports CSV reales de HPSM.
//
// ABIERTOS: grano incidente×sitio. Un mismo incidente puede afectar muchas
// ubicaciones (falla masiva), y el CSV trae una fila por sitio. Guardamos cada
// ubicación distinta para poder sacar "Top por Estado/Distrito". Cada carga
// reemplaza el snapshot del grupo (los abiertos son una foto del momento).
// ─────────────────────────────────────────────────────────────────────────────
model OpenIncident {
  id         String   @id @default(cuid())
  incidentId String
  openTime   DateTime
  status     String
  company    String
  serviceId  String
  state      String
  district   String
  assignee   String?
  group      String
  summary    String?
  uploadedAt DateTime @default(now())

  @@unique([incidentId, state, district])
  @@index([group])
  @@index([incidentId])
  @@index([state])
  @@index([district])
  @@index([assignee])
}

// ─────────────────────────────────────────────────────────────────────────────
// CERRADOS: grano incidente (sin sitio). Se sube por grupo (PEXA/CECOR). Trae la
// hora de apertura y cierre, con lo que calculamos el SLA (4 h) al momento de
// subir. Upsert por incidentId: re-subir el mismo día actualiza, no duplica.
// ─────────────────────────────────────────────────────────────────────────────
model ClosedIncident {
  incidentId     String   @id
  group          String
  openTime       DateTime
  closeTime      DateTime
  status         String
  closedBy       String
  resAnalystCode String
  resCause       String
  resolutionMins Int
  slaBreached    Boolean
  uploadedAt     DateTime @default(now())

  @@index([group])
  @@index([closedBy])
  @@index([resCause])
  @@index([slaBreached])
  @@index([closeTime])
}

// ─────────────────────────────────────────────────────────────────────────────
// ESCALADOS: incidentes marcados manualmente para atención especial. Vive aparte
// de OpenIncident porque ese snapshot se reemplaza completo cada 5 min; la marca
// debe sobrevivir. Se cruza por incidentId al consultar.
// ─────────────────────────────────────────────────────────────────────────────
model EscalatedIncident {
  incidentId String   @id
  markedBy   String
  note       String?
  flagged    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENTES TOP: base editable (empresa + referencia de servicio) que define los
// clientes críticos con chat directo. Al subir el snapshot de abiertos, cada
// incidente se compara contra esta base; si la empresa O el servicio coinciden,
// entra a War Room. Tabla chica (~93→300 filas): el match se hace en memoria.
// ─────────────────────────────────────────────────────────────────────────────
model ClienteTop {
  id         String   @id @default(cuid())
  siglasIm   String   @default("") // Siglas IM — primer criterio de match/búsqueda
  company    String
  serviceRef String   @default("")
  note       String?
  createdBy  String   @default("")
  createdAt  DateTime @default(now())

  @@index([siglasIm])
  @@index([company])
  @@index([serviceRef])
}

// ─────────────────────────────────────────────────────────────────────────────
// WAR ROOM: incidentes que coincidieron con un Cliente TOP. Vive aparte de
// OpenIncident porque ese snapshot se reemplaza cada 5 min; aquí PERSISTE para
// guardar historial de 7 días y medir recurrencia por cliente/servicio. Upsert
// por incidentId. resolvedAt se llena cuando el status pasa a "resolv" (alerta UP).
// ─────────────────────────────────────────────────────────────────────────────
model WarRoomIncident {
  incidentId  String    @id
  openTime    DateTime
  status      String    @default("")
  company     String    @default("")
  serviceId   String    @default("")
  state       String    @default("")
  district    String    @default("")
  assignee    String?
  group       String    @default("")
  matchedBy   String    @default("") // 'company' | 'service' | 'both'
  flagged     Boolean   @default(false)
  note        String?                 // nota editable por el operador
  dismissed   Boolean   @default(false) // X para quitar de la vista War Room
  resolvedAt  DateTime?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  @@index([company])
  @@index([serviceId])
  @@index([firstSeenAt])
  @@index([resolvedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTRATO MARCO: base de clientes con contrato marco (similar a Clientes TOP).
// Match en tiempo real contra OpenIncident por company, serviceRef o siglasIm.
// ─────────────────────────────────────────────────────────────────────────────
model ContratoMarco {
  id         String   @id @default(cuid())
  siglasIm   String   @default("")
  company    String
  serviceRef String   @default("")
  note       String?
  createdBy  String   @default("")
  createdAt  DateTime @default(now())

  @@index([siglasIm])
  @@index([company])
  @@index([serviceRef])
}

// Incidentes que coincidieron con un cliente de Contrato Marco.
// Persiste para notas/banderas/quitar. Historial UP: 12 horas (no 7 días).
model ContratoMarcoIncident {
  incidentId  String    @id
  openTime    DateTime
  status      String    @default("")
  company     String    @default("")
  serviceId   String    @default("")
  state       String    @default("")
  district    String    @default("")
  assignee    String?
  group       String    @default("")
  matchedBy   String    @default("")
  flagged     Boolean   @default(false)
  note        String?
  dismissed   Boolean   @default(false)
  resolvedAt  DateTime?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  @@index([company])
  @@index([serviceId])
  @@index([firstSeenAt])
  @@index([resolvedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// REPORTES WHATSAPP (EDC): copia del bloque de texto que el equipo publica en el
// grupo "STAFF SUPERVISIÓN". Se guarda tal cual (no se parsea) y se cruza por
// incidentId contra OpenIncident al consultar: solo se muestra mientras el IM
// siga abierto. Upsert por incidentId → 1 reporte vigente por IM (el último gana).
// ─────────────────────────────────────────────────────────────────────────────
model EdcReport {
  id         String   @id @default(cuid())
  incidentId String   @unique // IMxxxxxxx, llave de match contra OpenIncident
  rawText    String            // bloque completo tal cual del mensaje de WhatsApp
  sentAt     DateTime          // hora del mensaje en el grupo
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sentAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// BASE DE CONOCIMIENTO: enlaces / PDF / Drive con categoría. El Admin administra.
// ─────────────────────────────────────────────────────────────────────────────
model KnowledgeDoc {
  id        String   @id @default(cuid())
  title     String
  url       String
  category  String   @default("General")
  docType   String   @default("LINK") // LINK | PDF | DRIVE
  note      String?
  createdBy String   @default("")
  createdAt DateTime @default(now())

  @@index([category])
}

// ─────────────────────────────────────────────────────────────────────────────
// SISA: tickets del vendor (columna "Vendor Ticket" del export de HPSM). Snapshot
// reemplazable igual que OpenIncident — cada carga borra y reemplaza completo.
// incidentId es el prefijo antes del guion del "Id" del CSV (IM4CH000897-001 →
// IM4CH000897). El "Asignado" NO se guarda aquí: se toma en vivo de OpenIncident
// al consultar, y solo se muestran los que siguen coincidiendo con un abierto.
// ─────────────────────────────────────────────────────────────────────────────
model SisaTicket {
  incidentId   String   @id
  company      String   @default("")
  vendor       String   @default("") // CASE
  vendorTicket String   @default("") // SISA
  uploadedAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// WHATSAPP — GRUPOS DESTINO: grupos a los que el dashboard puede enviar mensajes
// (vía wa-listener). Se AUTO-DESCUBREN: cada vez que wa-listener ve un mensaje de
// un grupo, registra su chatId + nombre aquí (upsert por chatId). El envío usa el
// `chatId` directo (xxxx@g.us) — NO getChats(), que está roto por la versión de
// WhatsApp Web. `enabled` permite ocultar un grupo del selector sin borrarlo.
// ─────────────────────────────────────────────────────────────────────────────
model WhatsappGroup {
  id         String   @id @default(cuid())
  chatId     String   @unique // identificador real del grupo (xxxx@g.us) — llave de envío
  name       String   @default("") // nombre visible del grupo (último visto)
  enabled    Boolean  @default(true)
  note       String?
  createdBy  String   @default("") // "" cuando lo descubrió el listener
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([enabled])
}

// ─────────────────────────────────────────────────────────────────────────────
// WHATSAPP — CONTACTOS DE AGENTES: traduce el nombre libre que HPSM pone en
// OpenIncident.assignee (ej. "gpaniagu") al número de WhatsApp, para @mencionar
// al asignado en la alerta de servicio activo. hpsmName se guarda y compara en
// minúsculas: HPSM no garantiza mayúsculas estables entre exports.
// ─────────────────────────────────────────────────────────────────────────────
model AgentContact {
  id          String   @id @default(cuid())
  hpsmName    String   @unique // login de HPSM en minúsculas, ej. "gpaniagu"
  displayName String   @default("") // informativo para el ADMIN, ej. "Gustavo Paniagua"
  phone       String // sólo dígitos con país, ej. "5215512345678" (sin + ni @c.us)
  enabled     Boolean  @default(true)
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}

// ─────────────────────────────────────────────────────────────────────────────
// WHATSAPP — APERTURA DE INCIDENTE: control de "ya avisé este" para la alerta de
// apertura (Servicio en {C00,C20,C25,C50,C1G,G2B,G4B} → PEXA Matutino/Vespertino
// con @mención al asignado). OpenIncident es un snapshot que se recarga completo
// cada ~5 min, así que "nuevo" = primera vez que el incidentId aparece aquí.
// ─────────────────────────────────────────────────────────────────────────────
model AperturaNotificada {
  id         String   @id @default(cuid())
  incidentId String   @unique
  serviceId  String
  notifiedAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// WHATSAPP — MENSAJES ENVIADOS: bitácora de lo que se manda desde el dashboard
// (quién, a qué grupo, qué texto, si salió bien). Bajo volumen. Complementa el
// AuditLog: aquí queda el texto completo para trazabilidad operativa.
// ─────────────────────────────────────────────────────────────────────────────
model WhatsappSentMessage {
  id        String   @id @default(cuid())
  groupName String
  text      String
  sentBy    String // userId
  sentByName String  @default("")
  ok        Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sentBy])
}

// ─────────────────────────────────────────────────────────────────────────────
// MONITOREO DE IP — BASE: IPs capturadas a mano por el ADMIN, asociadas a una
// empresa/servicio. Persiste independientemente de los incidentes (no se borra
// al cerrarse un IM). Se va construyendo con el tiempo: se captura una vez y el
// sistema la reutiliza en cualquier incidente futuro de la misma empresa.
// notifyEnabled + notifyChatIds controlan si y a dónde se manda la alerta de
// servicio activo — configurado por el ADMIN al capturar/editar la IP.
// ─────────────────────────────────────────────────────────────────────────────
model MonitoredIp {
  id            String   @id @default(cuid())
  ip            String
  company       String
  serviceRef    String   @default("")
  siglasIm      String   @default("")
  label         String   @default("") // nombre libre, ej. "Enlace principal MTY"
  // "PING" = alcanzable desde internet, se monitorea con ping. "VPN" = no responde
  // desde internet, así que no se pinguea: la alerta UP se dispara cuando el
  // incidente pasa a RESOLV en HPSM.
  kind          String   @default("PING")
  note          String?
  notifyEnabled Boolean  @default(false)
  notifyChatIds String[] @default([]) // WhatsappGroup.chatId destino(s)
  createdBy     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  monitors      IpMonitor[]

  // La identidad de un enlace es (empresa, servicio), NO (empresa, ip): una misma
  // empresa puede tener varios servicios, cada uno con su IP, y la IP es justo el
  // dato que cambia al corregirla. Con la clave vieja @@unique([ip, company]) el
  // upsert de activación encontraba la fila del OTRO servicio y la reusaba, así que
  // el segundo incidente terminaba monitoreando la IP del primero.
  @@unique([company, serviceRef])
  @@index([company])
  @@index([serviceRef])
  @@index([siglasIm])
}

// ─────────────────────────────────────────────────────────────────────────────
// MONITOREO DE IP — ACTIVO: instancia de monitoreo ligada a un incidente abierto
// específico. Se crea al dar click en "Monitorear". `upSince` marca desde cuándo
// el ping responde sin interrupción; cuando lleva >= 1 minuto y aún no se avisó,
// se dispara la alerta UP (una sola vez por activación: `alertedAt`). Al cerrarse
// el incidente en OpenIncident, `active` pasa a false (el ping se detiene) pero
// el registro NO se borra — queda como historial.
// ─────────────────────────────────────────────────────────────────────────────
model IpMonitor {
  id                String      @id @default(cuid())
  monitoredIpId     String
  monitoredIp       MonitoredIp @relation(fields: [monitoredIpId], references: [id])
  incidentId        String
  company           String      @default("") // snapshot para mostrar aunque el incidente ya cierre

  active            Boolean     @default(true)
  lastCheckedAt     DateTime?
  lastUp            Boolean     @default(false)
  upSince           DateTime?   // desde cuándo responde sin cortes; null si el último ping falló
  lastLatencyMs     Int?
  lastMethod        String?     // "icmp" | "tcp"
  alertedAt         DateTime?   // se llenó = ya se mandó el WhatsApp de esta activación

  activatedBy       String      @default("")
  activatedAt       DateTime    @default(now())
  deactivatedAt     DateTime?
  deactivatedReason String?     // "incident_closed" | "manual"

  @@index([active])
  @@index([incidentId])
  @@index([monitoredIpId])
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum UserRole {
  IDS         // Ingeniero de Diagnóstico y Solución — ve y descarga todo, importa CSV, sin configuración
  SUPERVISOR  // IDS + configuración: gestión de usuarios y reglas de alerta
  ADMIN       // Acceso total (rol protegido: siempre debe existir al menos uno)
}

enum AlertTrigger {
  SLA_RISK
  SLA_BREACHED
  CRITICAL_OPEN
  CRITICAL_UNASSIGNED
}
