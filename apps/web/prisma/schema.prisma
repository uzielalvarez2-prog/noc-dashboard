generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Incident {
  id          String         @id
  title       String
  severity    Severity
  status      IncidentStatus
  assignedTo  String?
  slaDeadline DateTime
  slaBreached Boolean        @default(false)
  slaRiskAt   DateTime?
  source      String         @default("HPSM")
  rawData     Json
  createdAt   DateTime
  updatedAt   DateTime
  syncedAt    DateTime       @default(now())

  @@index([severity, status])
  @@index([slaDeadline])
  @@index([syncedAt])
}

model Operator {
  id        String  @id
  name      String
  email     String
  team      String
  isOnShift Boolean @default(false)
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  lastName     String     @default("")
  username     String     @default("")
  expediente   String     @default("")
  role         UserRole   @default(NOC_OPERATOR)
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
}

model AlertRule {
  id         String       @id @default(cuid())
  name       String
  trigger    AlertTrigger
  channels   String[]
  recipients String[]
  isActive   Boolean      @default(true)
  createdBy  String
  createdAt  DateTime     @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOC v2 — modelo basado en los exports CSV reales de HPSM.
//
// ABIERTOS: grano incidente×sitio. Un mismo incidente puede afectar muchas
// ubicaciones (falla masiva), y el CSV trae una fila por sitio. Guardamos cada
// ubicación distinta para poder sacar "Top por Estado/Distrito". Cada carga
// reemplaza el snapshot del grupo (los abiertos son una foto del momento).
// ─────────────────────────────────────────────────────────────────────────────
model OpenIncident {
  id         String   @id @default(cuid())
  incidentId String
  openTime   DateTime
  status     String
  company    String
  serviceId  String
  state      String
  district   String
  assignee   String?
  group      String
  uploadedAt DateTime @default(now())

  @@unique([incidentId, state, district])
  @@index([group])
  @@index([incidentId])
  @@index([state])
  @@index([district])
  @@index([assignee])
}

// ─────────────────────────────────────────────────────────────────────────────
// CERRADOS: grano incidente (sin sitio). Se sube por grupo (PEXA/CECOR). Trae la
// hora de apertura y cierre, con lo que calculamos el SLA (4 h) al momento de
// subir. Upsert por incidentId: re-subir el mismo día actualiza, no duplica.
// ─────────────────────────────────────────────────────────────────────────────
model ClosedIncident {
  incidentId     String   @id
  group          String
  openTime       DateTime
  closeTime      DateTime
  status         String
  closedBy       String
  resAnalystCode String
  resCause       String
  resolutionMins Int
  slaBreached    Boolean
  uploadedAt     DateTime @default(now())

  @@index([group])
  @@index([closedBy])
  @@index([resCause])
  @@index([slaBreached])
  @@index([closeTime])
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum UserRole {
  NOC_OPERATOR
  NOC_ADMIN
  ENGINEER
}

enum AlertTrigger {
  SLA_RISK
  SLA_BREACHED
  CRITICAL_OPEN
  CRITICAL_UNASSIGNED
}
