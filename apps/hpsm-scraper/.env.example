HPSM_URL=https://sm.cnoc.telmexit.com/sm/index.do?lang=en
HPSM_USER=
HPSM_PASSWORD=

# Carpeta donde se guardan los CSVs descargados
DOWNLOAD_DIR=C:\Users\Admin\noc-csvs

# Grupo y rango horario para el reporte de incidentes cerrados
HPSM_CLOSED_GROUP=PEXA
HPSM_CLOSED_START_TIME=07:00
HPSM_CLOSED_END_TIME=22:30

# true para ver el navegador mientras corre (debug); false en Task Scheduler
HEADED=false

# URL del dashboard (local o Vercel) y clave interna para el upload de CSVs
DASHBOARD_URL=https://your-dashboard.vercel.app
INTERNAL_API_KEY=
